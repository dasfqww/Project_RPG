<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="Narrative\Content\development.json" />
    <EmbeddedResource Include="Narrative\Content\development.json"
                      LogicalName="ProjectRpg.Backend.Narrative.Content.development.json" />
    <PackageReference Include="Npgsql" Version="9.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="DevelopmentProfiles\Training.json;DevelopmentProfiles\Intro1.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Database\schema.sql"
             Link="Database\schema.sql"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Database\Migrations\0002_item_equipment_progression.sql"
             Link="Database\Migrations\0002_item_equipment_progression.sql"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Database\Migrations\0003_character_narrative.sql"
             Link="Database\Migrations\0003_character_narrative.sql"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ProjectRpg.Operations.Core/ProjectRpg.Operations.Core.csproj" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.2" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <Content Include="../Database/Migrations/0004_operations_sessions.sql"
             Link="Database/Migrations/0004_operations_sessions.sql"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../Database/Migrations/0005_operations_evidence.sql" Link="Database/Migrations/0005_operations_evidence.sql"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Database/Migrations/0006_operations_compensation.sql" Link="Database/Migrations/0006_operations_compensation.sql"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup><Content Include="../Database/Migrations/0007_operations_restrictions.sql" Link="Database/Migrations/0007_operations_restrictions.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Content Include="../Database/Migrations/0008_trade_reservations.sql" Link="Database/Migrations/0008_trade_reservations.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Content Include="../Database/Migrations/0009_operations_service_control.sql" Link="Database/Migrations/0009_operations_service_control.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Content Include="../Database/Migrations/0010_trade_sessions.sql" Link="Database/Migrations/0010_trade_sessions.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Content Include="../Database/Migrations/0011_inventory_tabs.sql" Link="Database/Migrations/0011_inventory_tabs.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Content Include="../Database/Migrations/0012_auction_escrow.sql" Link="Database/Migrations/0012_auction_escrow.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Content Include="../Database/Migrations/0013_auction_sales.sql" Link="Database/Migrations/0013_auction_sales.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Content Include="../Database/Migrations/0014_auction_claims.sql" Link="Database/Migrations/0014_auction_claims.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
</Project>
