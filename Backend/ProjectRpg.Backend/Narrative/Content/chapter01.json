  "chapters": [],
  "dialogues": [
    {
      "id": "CH01.M01.Offer",
      "speaker": "미라",
      "text": "폐광으로 간 수레에서 연락이 끊겼어요. 사람들이 어디 있는지 확인해 주세요.",
      "questId": "CH01.M01",
      "requiredStatus": null,
      "choices": [
        {
          "id": "accept",
          "text": "의뢰 수락",
          "effect": "AcceptQuest"
        }
      ]
    },
    {
      "id": "CH01.D01",
      "speaker": "미라",
      "text": "일거리를 찾고 있나요? 폐광으로 간 수레에서 연락이 끊겼어요. 짐보다 먼저, 사람들이 어디 있는지 확인해 주세요.",
      "questId": "CH01.M01",
      "requiredStatus": "Active",
      "choices": [
        {
          "id": "confirm",
          "text": "수레가 멈춘 곳부터 확인하겠습니다.",
          "effect": "RecordObjective",
          "objectiveId": "contact"
        }
      ]
    },
    {
      "id": "CH01.D02",
      "speaker": "로엔",
      "text": "들어가는 것보다 돌아오는 게 어렵지. 현장에 나가기 전에 네 움직임부터 보자.",
      "questId": "CH01.M01",
      "requiredStatus": "Active",
      "choices": [
        {
          "id": "confirm",
          "text": "현장 준비를 확인했습니다.",
          "effect": "RecordObjective",
          "objectiveId": "preparation"
        }
      ]
    },
    {
      "id": "CH01.M02.Offer",
      "speaker": "로엔",
      "text": "현장에 설 자격을 보여줘. 기존 훈련에서 기본 움직임을 확인하자.",
      "questId": "CH01.M02",
      "requiredStatus": null,
      "choices": [
        {
          "id": "accept",
          "text": "의뢰 수락",
          "effect": "AcceptQuest"
        }
      ]
    },
    {
      "id": "CH01.M03.Offer",
      "speaker": "미라",
      "text": "마지막 수레는 갱도 앞에서 멈췄다고 해요. 약탈이라는 말도 있지만, 확인한 사람은 없어요.",
      "questId": "CH01.M03",
      "requiredStatus": null,
      "choices": [
        {
          "id": "accept",
          "text": "의뢰 수락",
          "effect": "AcceptQuest"
        }
      ]
    },
    {
      "id": "CH01.M04.Offer",
      "speaker": "현장 목표",
      "text": "안쪽에서 응답이 돌아왔다. 봉쇄를 건드리지 않고 점검 통로로 접근하자.",
      "questId": "CH01.M04",
      "requiredStatus": null,
      "choices": [
        {
          "id": "accept",
          "text": "의뢰 수락",
          "effect": "AcceptQuest"
        }
      ]
    },
    {
      "id": "CH01.M05.Offer",
      "speaker": "현장 목표",
      "text": "접근로를 확보했다. 안쪽의 공격 기회를 확인하고, 응답을 남긴 사람을 찾자.",
      "questId": "CH01.M05",
      "requiredStatus": null,
      "choices": [
        {
          "id": "accept",
          "text": "생존자의 증언 수락",
          "effect": "AcceptQuest"
        }
      ]
    },
    {
      "id": "CH01.D05",
      "speaker": "다온",
      "text": "버팀목은 제가 걸었습니다. 저것이 밖으로 나가면 마을까지 갈 테니까요. 동료들은 안쪽 대피실로 옮겨야 합니다.",
      "questId": "CH01.M05",
      "requiredStatus": "Active",
      "choices": [
        {
          "id": "confirm",
          "text": "남은 사람들을 데리고 나갈 길을 찾겠습니다.",
          "effect": "RecordObjective",
          "objectiveId": "testimony"
        }
      ]
    },
    {
      "id": "CH01.D06.Preview",
      "speaker": "다온",
      "text": "걷지 못하는 사람부터 옮깁시다. 저 문 안쪽까지 가면 잠깐은 버틸 수 있어요.",
      "questId": null,
      "requiredStatus": null,
      "informational": true,
      "requiredCompletedQuests": [
        "CH01.M05"
      ],
      "choices": [
        {
          "id": "close",
          "text": "안쪽 대피실로 갈 길을 확인한다.",
          "effect": "None"
        }
      ]
    },
    {
      "id": "CH01.M06.Offer",
      "speaker": "다온",
      "text": "걷지 못하는 사람부터 옮깁시다. 저 문 안쪽까지 가면 잠깐은 버틸 수 있어요. 아직 광산 밖으로 나간 것은 아닙니다.",
      "questId": "CH01.M06",
      "requiredStatus": null,
      "choices": [
        {
          "id": "accept",
          "text": "함께 열어야 하는 길 수락",
          "effect": "AcceptQuest"
        }
      ]
    },
    {
      "id": "CH01.D06",
      "speaker": "다온",
      "text": "먼저 부상자들의 상태를 확인해 주세요. 제가 차단문을 준비하는 동안 힘을 모아 길을 열고, 두 차례 밀려오는 적을 막아 주세요. 방어가 끝나면 안쪽 안전지점으로 함께 빠집시다. 이미 이 실습을 마쳤다면 대피실에서 빠진 현장 확인만 하면 됩니다.",
      "questId": "CH01.M06",
      "requiredStatus": "Active",
      "choices": [
        {
          "id": "confirm",
          "text": "부상자 확인 후 보호·내부 대피를 진행하겠습니다.",
          "effect": "RecordObjective",
          "objectiveId": "briefing"
        }
      ]
    },
    {
      "id": "CH01.D07.Preview",
      "speaker": "다온",
      "text": "부상자들은 내부 차단문 뒤에서 잠시 버틸 수 있습니다. 광산 밖으로 나가려면 주갱도와 돌아갈 길을 확보해야 합니다. 아직 최종 반출은 끝나지 않았어요.",
      "questId": null,
      "requiredStatus": null,
      "informational": true,
      "requiredCompletedQuests": [
        "CH01.M06"
      ],
      "choices": [
        {
          "id": "close",
          "text": "다음 목표: 돌아갈 길과 주갱도 확보",
          "effect": "None"
        }
      ]
    }
  ]
