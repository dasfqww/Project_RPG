{
  "Auth": {
    "SessionLifetimeMinutes": 60,
    "JoinTicketLifetimeSeconds": 60,
    "GameServerTokenLifetimeMinutes": 720,
    "AdminToken": ""
  },
  "Steam": {
    "AppId": 480,
    "PublisherKey": "",
    "TicketIdentity": "ProjectRpgBackend",
    "AuthenticateUserTicketUrl": "https://partner.steam-api.com/ISteamUserAuth/AuthenticateUserTicket/v1/",
    "AllowDevelopmentAuthentication": false
  },
  "Storage": {
    "Provider": "Postgres",
    "ReadinessTimeoutSeconds": 3
  },
  "RateLimits": {
    "Enabled": true,
    "WindowSeconds": 60,
    "AuthenticationPermitLimit": 60,
    "IngressPermitLimit": 6000,
    "PlayerPermitLimit": 600,
    "GameServerPermitLimit": 6000,
    "AdministratorPermitLimit": 3000
  },
  "Trading": {
    "Enabled": false,
    "CurrencyCode": "Gold",
    "Items": []
  },
  "Auctions": {
    "Enabled": false
  },
  "DungeonSessions": {
    "MaxPartySize": 4,
    "MinimumDeparturePartySize": 1,
    "WaitingLifetimeMinutes": 5,
    "ServerStartupLeaseSeconds": 300,
    "ActiveLeaseSeconds": 90
  },
  "DungeonContent": {
    "Entries": [
      {
        "DungeonId": "Dungeon.RaidSwordMan",
        "MapPackage": "/Game/Maps/bossmap",
        "Difficulties": [ "Easy", "Normal", "Hard", "Hell" ]
      }
    ]
  },
  "DungeonSettlements": {
    "PollIntervalMilliseconds": 250,
    "ProcessingLeaseSeconds": 30,
    "MaximumAttempts": 10,
    "MaximumRetryDelaySeconds": 30
  },
  "SecurityTelemetry": {
    "PostSessionGraceSeconds": 300
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:3000"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
