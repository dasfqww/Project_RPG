{
  "Auth": {
    "SessionLifetimeMinutes": 60,
    "JoinTicketLifetimeSeconds": 60,
    "GameServerTokenLifetimeMinutes": 720,
    "AdminToken": ""
  },
  "Steam": {
    "AppId": 480,
    "PublisherKey": "",
    "TicketIdentity": "ProjectRpgBackend",
    "AuthenticateUserTicketUrl": "https://partner.steam-api.com/ISteamUserAuth/AuthenticateUserTicket/v1/",
    "AllowDevelopmentAuthentication": false
  },
  "Storage": {
    "Provider": "Postgres"
  },
  "DungeonSessions": {
    "MaxPartySize": 4,
    "WaitingLifetimeMinutes": 5,
    "ActiveLeaseSeconds": 90
  },
  "DungeonSettlements": {
    "PollIntervalMilliseconds": 250,
    "ProcessingLeaseSeconds": 30,
    "MaximumAttempts": 10,
    "MaximumRetryDelaySeconds": 30
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:3000"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
