@page "/ops/characters/{id}/compensation"
@model ProjectRpg.Backend.Pages.Ops.CompensationModel
@using ProjectRpg.Operations.Core.Compensation
<h1>개별 아이템 보상</h1>
@if (Model.Error is not null) { <p class="error">@Model.Error.Code · 최근 지급 근거를 확인한 뒤 다시 시도하세요.</p> }
@if (Model.Character is not null && Model.Actions is not null)
{
<p><a href="/ops/characters/@Model.Character.CharacterId">@Model.Character.Name</a> · <code>@Model.Character.CharacterId</code> · <a href="/ops/characters/@Model.Character.CharacterId/evidence">보상 근거 조사</a></p>
<h2>최근 확정 보상</h2>
<table><thead><tr><th>확정 시각</th><th>사건·요청 번호</th><th>지급</th><th>사유</th></tr></thead><tbody>
@foreach (var action in Model.Actions.Items)
{
<tr><td>@action.CommittedAtUtc.ToString("u")</td><td>@action.CaseId<br /><a href="/ops/api/actions/@action.RequestId">@action.RequestId</a><br /><a href="@ProjectRpg.Backend.Pages.Ops.CompensationModel.LogLink(action)">추적 로그</a></td><td>@action.Result.DefinitionKey × 1<br />@action.Result.ItemId</td><td>@action.Reason</td></tr>
}
</tbody></table>
@if (Model.Actions.Items.Count == 0) { <p>확정된 운영 보상이 없습니다.</p> }
@if (Model.Actions.NextCursor is not null) { <a href="?cursor=@Uri.EscapeDataString(Model.Actions.NextCursor)&limit=@(Request.Query["limit"].FirstOrDefault() ?? "50")">이전 보상 더 보기</a> }
<p>조사한 사건마다 같은 사건 번호를 사용하세요. 캐릭터가 접속·던전·정산 중이면 지급할 수 없습니다. 확정한 아이템은 다음 로비·우편 재조회에 표시됩니다.</p>
<div id="compensation" data-character="@Model.Character.CharacterId" data-storage="@Model.StorageKey">
<form id="preview-form">@Html.AntiForgeryToken()
<label>조사 사건 UUID <input name="caseId" required maxlength="36" autocomplete="off" /></label>
<label>품목 <select name="definitionKey" required>@foreach (string definition in Model.Definitions) { <option value="@definition">@definition</option> }</select></label>
<label>보상 사유 <input name="reason" required minlength="10" maxlength="512" size="50" /></label>
<button type="submit" disabled="@(Model.Definitions.Count == 0)">미리보기</button>
</form>
@if (Model.Definitions.Count == 0) { <p>현재 지급을 허용한 품목이 없습니다.</p> }
<pre id="preview" style="white-space:pre-wrap"></pre>
<button id="commit" type="button" disabled>확인한 보상 지급</button>
<button id="refresh-preview" type="button" hidden>같은 요청의 미리보기 갱신</button>
<button id="new-intent" type="button" hidden>확정 결과 확인 완료 · 다른 사건 조사</button>
<p id="status" role="status" aria-live="polite"></p>
<h2>요청 결과 복구</h2>
<p>응답을 받지 못해도 새 요청을 만들지 마세요. 아래 번호를 조회하거나 같은 요청으로 재시도하세요. 404는 미확정 상태일 수 있습니다.</p>
<form id="lookup-form"><label>요청 UUID <input name="requestId" required maxlength="36" size="38" /></label><button>결과 조회</button></form>
<ul id="request-history"></ul>
</div>
<script nonce="@HttpContext.Items["Ops.ScriptNonce"]">
(() => {
  'use strict';
  const root = document.getElementById('compensation'), form = document.getElementById('preview-form');
  const status = document.getElementById('status'), detail = document.getElementById('preview');
  const commit = document.getElementById('commit'), fresh = document.getElementById('new-intent');
  const refresh = document.getElementById('refresh-preview');
  const lookup = document.getElementById('lookup-form'), key = root.dataset.storage;
  const tokenKey = key + '.token.' + root.dataset.character;
  let pending = null, busy = false;
  const message = value => { status.textContent = value; };
  function history() {
    const rows = JSON.parse(localStorage.getItem(key + '.requests') || '[]');
    if (!Array.isArray(rows)) throw new Error('요청 기록 저장소를 읽을 수 없습니다.');
    const list = document.getElementById('request-history'); list.replaceChildren();
    for (const row of rows.slice(0,20)) {
      if (!/^[a-f0-9-]{36}$/.test(row.id)) continue;
      const li = document.createElement('li'), button = document.createElement('button');
      button.type = 'button'; button.textContent = row.id;
      button.onclick = () => { lookup.elements.requestId.value = row.id; lookup.requestSubmit(); };
      li.append(button); list.append(li);
    }
    return rows;
  }
  async function api(path, body) {
    const response = await fetch(path, body ? {method:'POST', credentials:'same-origin',
      headers:{'Content-Type':'application/json','X-Ops-CSRF':form.elements.__RequestVerificationToken.value},
      body:JSON.stringify(body)} : {credentials:'same-origin'});
    const result = await response.json();
    if (!response.ok) {
      const error = new Error((result.code || '조회 실패') + ' · 추적 번호 ' + (result.httpRequestId || '없음'));
      error.code = result.code; throw error;
    }
    return result.data;
  }
  function resolved(receipt) {
    detail.textContent = JSON.stringify(receipt, null, 2);
    message('지급 확정 · 요청 ' + receipt.requestId + ' · 우편을 다시 조회하세요.');
    if (pending && pending.requestId === receipt.requestId) {
      sessionStorage.removeItem(tokenKey); pending = null; commit.disabled = true;
      fresh.hidden = false; refresh.hidden = true;
    }
  }
  form.onsubmit = async event => {
    event.preventDefault(); if (busy) return;
    if (pending && pending.requestId) { message('먼저 기존 요청 결과를 조회하거나 같은 요청으로 재시도하세요.'); return; }
    busy = true;
    try {
      const data = await api('/ops/api/compensations/preview', {characterId:root.dataset.character,
        caseId:form.elements.caseId.value, templateId:'Ops.Compensation.Item.v1',
        definitionKey:form.elements.definitionKey.value, reason:form.elements.reason.value});
      pending = {previewToken:data.previewToken, intent:data.normalizedIntent, expiresAtUtc:data.expiresAtUtc};
      sessionStorage.setItem(tokenKey, JSON.stringify(pending));
      detail.textContent = JSON.stringify({ ...data.normalizedIntent, quantity:1, destination:'우편', expiresAtUtc:data.expiresAtUtc }, null, 2);
      commit.disabled = false; fresh.hidden = true; refresh.hidden = false; message('대상·사건·품목·사유를 확인한 뒤 지급하세요.');
    } catch (error) { message(error.message); } finally { busy = false; }
  };
  commit.onclick = async () => {
    if (busy || !pending) return; busy = true; commit.disabled = true;
    try {
      if (!pending.requestId) pending.requestId = crypto.randomUUID();
      // Persist BOTH recovery ID and token before ANY mutation is sent; storage failure refuses submission.
      sessionStorage.setItem(tokenKey, JSON.stringify(pending));
      const rows = history().filter(row => row.id !== pending.requestId);
      localStorage.setItem(key + '.requests', JSON.stringify([{id:pending.requestId, characterId:root.dataset.character}, ...rows].slice(0,20)));
      history(); lookup.elements.requestId.value = pending.requestId;
      message('처리 중 · 요청 ' + pending.requestId);
      const data = await api('/ops/api/compensations', {requestId:pending.requestId, previewToken:pending.previewToken});
      resolved(data.receipt);
    } catch (error) {
      message(error.message + ' · 원래 요청 번호를 조회하거나 같은 요청으로 재시도하세요.');
      if (['ops.case_already_compensated','ops.compensation_not_allowed'].includes(error.code)) {
        fresh.hidden = false; fresh.textContent = '지급 거절 확인 · 요청 기록 보존 후 입력 초기화';
      }
    }
    finally { busy = false; commit.disabled = !pending; commit.textContent = pending?.requestId ? '같은 요청으로 재시도' : '확인한 보상 지급'; }
  };
  lookup.onsubmit = async event => {
    event.preventDefault(); if (busy) return; busy = true;
    try { resolved(await api('/ops/api/actions/' + encodeURIComponent(lookup.elements.requestId.value))); }
    catch (error) { message(error.message + ' · 새 요청 번호를 자동 발급하지 않습니다.'); }
    finally { busy = false; }
  };
  refresh.onclick = async () => {
    if (busy || !pending) return; busy = true;
    try {
      const data = await api('/ops/api/compensations/preview', pending.intent);
      const updated = {...pending, previewToken:data.previewToken, intent:data.normalizedIntent, expiresAtUtc:data.expiresAtUtc};
      sessionStorage.setItem(tokenKey, JSON.stringify(updated)); pending = updated;
      detail.textContent = JSON.stringify({...pending.intent, expiresAtUtc:pending.expiresAtUtc}, null, 2);
      message('같은 대상·사건·요청 번호로 미리보기를 갱신했습니다. 확인 후 재시도하세요.');
    } catch (error) { message(error.message); } finally { busy = false; }
  };
  fresh.onclick = () => {
    if (busy) return;
    try { sessionStorage.removeItem(tokenKey); pending = null; }
    catch { message('저장소 오류로 입력 초기화를 중단했습니다.'); return; }
    commit.disabled = true; refresh.hidden = true; detail.textContent = ''; form.reset(); fresh.hidden = true;
    message('다음 사건의 근거와 최근 보상을 확인하세요.');
  };
  try {
    history(); pending = JSON.parse(sessionStorage.getItem(tokenKey) || 'null');
    if (pending) {
      detail.textContent = JSON.stringify(pending.intent, null, 2); commit.disabled = false; refresh.hidden = false;
      if (pending.requestId) { lookup.elements.requestId.value = pending.requestId; commit.textContent = '같은 요청으로 재시도'; }
      message('저장한 요청을 복구했습니다. 결과를 조회하거나 확인 후 재시도하세요.');
    }
  } catch { commit.disabled = true; message('브라우저 저장소를 사용할 수 없어 지급을 중단했습니다.'); }
})();
</script>
}
